{
    "name": "Dev Agent",
    "image": "dev-agent:dev",
    "remoteUser": "devops",
    "init": true,
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "containerEnv": {
        "GIT_SSH_COMMAND": "ssh"
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/opt/dev-agent,type=bind,readonly",
        "source=dev-agent-pi-agent,target=/var/lib/dev-agent/pi/agent,type=volume",
        "source=dev-agent-pi-sessions,target=/var/lib/dev-agent/pi/sessions,type=volume"
    ]
}
